# MongoDB Atlas (mongodb+srv://user:pass@cluster/...)
MONGODB_URI=
MONGODB_DB=praxis

# JWT de sesión (mínimo 32 caracteres). Generar con: openssl rand -base64 32
SESSION_SECRET=replace-with-openssl-rand-base64-32

# praxis queda como administrador. Si faltan, también se crean
# sofia, diego y valeria (cuentahabientes) con esta misma contraseña.
AUTH_SEED_USERNAME=praxis
AUTH_SEED_PASSWORD=change-me

# Firebase Cloud Messaging. La config NEXT_PUBLIC_* va al cliente y al service worker.
# La cuenta de servicio solo la lee el servidor. Sin estas variables no hay avisos
# y las transferencias siguen confirmándose.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# https://console.firebase.google.com/project/praxis-demo-core-banking/settings/cloudmessaging
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# https://console.firebase.google.com/project/praxis-demo-core-banking/settings/serviceaccounts/adminsdk
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
